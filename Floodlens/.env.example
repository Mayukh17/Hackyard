# ─────────────────────────────────────────────
# FloodLens — Environment Variables
# Copy this file to backend/.env and fill in values
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
# Google Gemini API key (used for vision classification)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Supabase (recommended for production) ──
# If left empty, the app falls back to local SQLite + disk storage
# Create a free project at: https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
